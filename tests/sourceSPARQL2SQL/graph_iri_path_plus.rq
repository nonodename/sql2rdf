PREFIX ex: <http://example.com/ns#>
# A NAMED graph needs no invariant column (unlike graph_var_path_plus.rq):
# its condition sits inside the step relation's own WHERE, identically in every
# arm, so the closure keeps the plain two-column shape.
SELECT ?s ?o
WHERE { GRAPH <http://example.com/graph/g1> { ?s ex:dept+ ?o . } }
