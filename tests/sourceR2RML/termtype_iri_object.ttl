@prefix rr:  <http://www.w3.org/ns/r2rml#>.
@prefix ex:  <http://example.com/ns#>.

# Repro fixture: an rr:column-based object map with explicit rr:termType
# rr:IRI must emit an IRI object, not a literal.
<#TriplesMap1>
    rr:logicalTable [ rr:tableName "FROG" ];
    rr:subjectMap [ rr:template "http://example.com/frog/{ID}" ];
    rr:predicateObjectMap [ rr:predicate ex:attribute;
        rr:objectMap [ rr:column "TARGET"; rr:termType rr:IRI ] ];
    rr:predicateObjectMap [ rr:predicate ex:attributeTemplate;
        rr:objectMap [ rr:template "frog:F0009/{TARGET}"; rr:termType rr:IRI ] ].
