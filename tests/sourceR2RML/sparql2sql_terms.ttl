@prefix rr:  <http://www.w3.org/ns/r2rml#>.
@prefix ex:  <http://example.com/ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

# Toy mapping for the SPARQL-to-SQL translator's RDF term dimension.
#
# Read as two halves. The single-arm predicates below each pin one point of the
# TermInfo lattice, so a query binding a variable through one of them has a
# known, *specific* static annotation to assert on - and generates SQL with no
# runtime type tag anywhere, because nothing needs deciding per row.
#
# The multi-arm predicates at the bottom (ex:mixed, ex:desc, ex:mixedtag,
# ex:mixeddt) are produced by BOTH triples maps with DIFFERENT dimensions, over
# different tables. Their meet is degraded, so nothing can be folded - and since
# the two arms are unioned, a single query over one of them really does return
# rows whose term dimension differs from row to row. That is what the runtime
# type-tag column (mangleVarTag / TagSql.h) exists for, and these four are the
# only fixtures in the suite that exercise it.
#
# Single-arm predicates:
#
#   subject      -> IRI, via rr:template
#   ex:amount    -> Literal, xsd:integer  (declared rr:datatype)
#   ex:price     -> Literal, xsd:decimal  (declared)
#   ex:when      -> Literal, xsd:dateTime (declared)
#   ex:title     -> Literal, rdf:langString @en  (declared rr:language)
#   ex:plain     -> Literal, datatype NOT statically known (bare rr:column, and
#                   no TypeCatalog is supplied by test_runner) - the case that
#                   keeps a meaningful DATATYPE() negative alive
#   ex:rawamount -> same, over a numeric column: the STRDT() re-tagging input
#   ex:homepage  -> IRI, via rr:termType on an rr:column
#   ex:badtyped  -> Literal, *mis-declared* xsd:integer over a VARCHAR column:
#                   pins that a declared datatype that the data contradicts
#                   yields NULL (row dropped) rather than a runtime error
#
# Multi-arm predicates - the per-row cases:
#
# ex:mixed differs in term KIND (an IRI from <#Measure>, a literal from
#   <#Note>), so its meet is Unknown: isIRI()/isLITERAL() cannot fold and must
#   test the tag instead.
#
# ex:desc is a literal in each arm but with DIFFERENT rr:language values ("en"
#   vs "fr"), so the kind and rdf:langString survive the meet while the specific
#   tag does not: LANG() cannot fold and must read the tag.
#
# ex:mixedtag is a literal in each arm, but ONE arm is rr:language "en"
#   (rdf:langString) and the OTHER declares nothing at all - so unlike ex:desc
#   the arms' datatypeIri disagree too, and meet() degrades that as well. This is
#   the case that must never be confused with "no rr:language anywhere"
#   (ex:plain): the mapping DOES prove one arm is language-tagged, so LANG() must
#   not answer "" - and after the tag lowering, must not tag it "L" either.
#
# ex:mixeddt differs only in DATATYPE (xsd:integer over MEASURES.AMOUNT vs
#   xsd:string over NOTES.BODY). Textually indistinguishable from ex:plain in the
#   meet's three fields - both come out "a literal with no datatype" - which is
#   precisely why TermInfo carries `degraded`: ex:plain lowers to the "L" tag
#   ("the mapping cannot determine this datatype"), while ex:mixeddt must not,
#   because every row of it has a perfectly good datatype that just is not the
#   same one. It is also the fixture for value-space dispatch: comparing an
#   xsd:integer row against an xsd:string row is a type error, not a false.

<#Measure>
    rr:logicalTable [ rr:tableName "MEASURES" ];
    rr:subjectMap [ rr:template "http://ex.org/m/{ID}" ];
    rr:predicateObjectMap [ rr:predicate ex:amount;
        rr:objectMap [ rr:column "AMOUNT"; rr:datatype xsd:integer ] ];
    rr:predicateObjectMap [ rr:predicate ex:rawamount;
        rr:objectMap [ rr:column "AMOUNT" ] ];
    rr:predicateObjectMap [ rr:predicate ex:price;
        rr:objectMap [ rr:column "PRICE"; rr:datatype xsd:decimal ] ];
    rr:predicateObjectMap [ rr:predicate ex:when;
        rr:objectMap [ rr:column "WHEN_DT"; rr:datatype xsd:dateTime ] ];
    rr:predicateObjectMap [ rr:predicate ex:title;
        rr:objectMap [ rr:column "TITLE"; rr:language "en" ] ];
    rr:predicateObjectMap [ rr:predicate ex:plain;
        rr:objectMap [ rr:column "TITLE" ] ];
    rr:predicateObjectMap [ rr:predicate ex:badtyped;
        rr:objectMap [ rr:column "TITLE"; rr:datatype xsd:integer ] ];
    rr:predicateObjectMap [ rr:predicate ex:homepage;
        rr:objectMap [ rr:column "HOMEPAGE"; rr:termType rr:IRI ] ];
    rr:predicateObjectMap [ rr:predicate ex:mixed;
        rr:objectMap [ rr:template "http://ex.org/m/{REF}" ] ];
    rr:predicateObjectMap [ rr:predicate ex:desc;
        rr:objectMap [ rr:column "TITLE"; rr:language "en" ] ];
    rr:predicateObjectMap [ rr:predicate ex:mixedtag;
        rr:objectMap [ rr:column "TITLE"; rr:language "en" ] ];
    rr:predicateObjectMap [ rr:predicate ex:mixeddt;
        rr:objectMap [ rr:column "AMOUNT"; rr:datatype xsd:integer ] ].

# A blank-node subject map - only reachable since buildSubjectMap started
# honouring rr:termType (see tests/sourceR2RML/subject_blanknode.ttl).
<#Note>
    rr:logicalTable [ rr:tableName "NOTES" ];
    rr:subjectMap [ rr:template "note{NID}"; rr:termType rr:BlankNode ];
    rr:predicateObjectMap [ rr:predicate ex:body;
        rr:objectMap [ rr:column "BODY" ] ];
    rr:predicateObjectMap [ rr:predicate ex:mixed;
        rr:objectMap [ rr:column "BODY" ] ];
    rr:predicateObjectMap [ rr:predicate ex:desc;
        rr:objectMap [ rr:column "BODY"; rr:language "fr" ] ];
    rr:predicateObjectMap [ rr:predicate ex:mixedtag;
        rr:objectMap [ rr:column "BODY" ] ];
    rr:predicateObjectMap [ rr:predicate ex:mixeddt;
        rr:objectMap [ rr:column "BODY"; rr:datatype xsd:string ] ].
